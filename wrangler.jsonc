{
  "name": "games",
  "main": "src/index.ts",
  "compatibility_date": "2026-09-01",
  "routes": [{ "pattern": "games.amittal.dev", "custom_domain": true }],
  "assets": { "directory": "public", "binding": "ASSETS", "html_handling": "drop-trailing-slash", "not_found_handling": "404-page", "run_worker_first": ["/api/*", "/internal/*", "/r/*"] },
  // One Durable Object per room: it holds the room's state and everyone's WebSocket. One more, Stats, keeps the
  // site-wide counts the Switchboard reads at /internal/stats (secret: INTERNAL_KEY, the Switchboard's).
  "durable_objects": { "bindings": [{ "name": "ROOMS", "class_name": "Room" }, { "name": "STATS", "class_name": "Stats" }] },
  "migrations": [{ "tag": "v1", "new_sqlite_classes": ["Room"] }, { "tag": "v2", "new_sqlite_classes": ["Stats"] }],
  "rules": [{ "type": "Text", "globs": ["**/*.txt"], "fallthrough": true }],
  "dev": { "port": 8799 }
}
